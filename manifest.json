{
  "manifest_version": 3,
  "name": "LinkPilot - LinkedIn Lead & Automation Suite",
  "version": "1.0.0",
  "description": "Smart LinkedIn Management: Track daily sent requests, auto-extract Phone & Portfolio leads, AI profile review & 1/2-day smart follow-ups.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LinkPilot - LinkedIn Management",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "lib/storage.js",
        "lib/ai-engine.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/content.css"
      ],
      "matches": [
        "*://*.linkedin.com/*"
      ]
    }
  ]
}
